# Allowlist. Ignore everything, then re-include what ships.
#
# A blocklist has to name each excluded path, which makes the file an index of
# what it excludes. This one names only what is already public.
/*

!/.gitignore
!/.npmignore
!/LICENSE
!/README.md
!/package.json
!/tsconfig.json
!/tsconfig.mcp.json
!/strata.guide.example.json
!/src/
!/bin/
!/templates/
!/docs/
!/scripts/
!/benchmark/

# ── never, at any depth ──
node_modules/
dist/
*.log
*.tgz
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# ── scripts: the tools a contributor actually runs ──
/scripts/*
!/scripts/admit-recall.js
!/scripts/compose-and-verify.js
!/scripts/index-verified.js
!/scripts/mutation-sweep.js
!/scripts/render-banner-svg.js
!/scripts/render-benchmark-svg.js
!/scripts/sync-gitignore.js
!/scripts/test-selection.js

# ── docs: the writeup and its generated charts ──
/docs/*
!/docs/BENCHMARK.md
!/docs/assets/
/docs/assets/*
!/docs/assets/banner.svg
!/docs/assets/benchmark-dark.svg
!/docs/assets/benchmark-light.svg

# ── benchmark: the current battery only ──
/benchmark/*
!/benchmark/quality/
!/benchmark/fixtures/
!/benchmark/harness/
!/benchmark/runs/
!/benchmark/*.js
!/benchmark/*.ts

/benchmark/runs/*
!/benchmark/runs/exp-quality/

# Module source is delivered from the hub at call time and is never published.
# These are the paths it lands in inside an output tree.
/benchmark/runs/**/strata/lib.js
/benchmark/runs/**/strata/selftest.js
/benchmark/runs/**/strata/tests/
/benchmark/runs/**/strata/composed-pkg/

# Install artifacts of the archived trees — the sessions' code is the artifact, not their lockfiles.
/benchmark/runs/**/package-lock.json
