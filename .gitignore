# Allowlist. Ignore everything, then re-include what ships.
#
# A blocklist has to name each excluded path, which makes the file an index of
# what it excludes. This one names only what is already public.
/*

!/.gitignore
!/.npmignore
!/LICENSE
!/README.md
!/CHANGELOG.md
!/package.json
!/tsconfig.json
!/tsconfig.mcp.json
!/strata.guide.example.json
!/src/
!/bin/
!/templates/
!/docs/
!/scripts/
!/benchmark/

# ── never, at any depth ──
node_modules/
dist/
*.log
*.tgz
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# ── scripts: the tools a contributor actually runs ──
/scripts/*
!/scripts/admit-recall.js
!/scripts/compose-and-verify.js
!/scripts/index-verified.js
!/scripts/mutation-sweep.js
!/scripts/render-banner-svg.js
!/scripts/render-benchmark-svg.js
!/scripts/render-consistency-svg.js
!/scripts/render-savings-svg.js
!/scripts/sync-gitignore.js
!/scripts/test-claude-preset.js
!/scripts/test-selection.js

# ── docs: the writeup, its charts, and the superseded battery ──
/docs/*
!/docs/BENCHMARK.md
!/docs/archive/
!/docs/assets/
/docs/assets/*
!/docs/assets/banner.svg
!/docs/assets/benchmark-dark.svg
!/docs/assets/benchmark-light.svg
!/docs/assets/consistency-dark.svg
!/docs/assets/consistency-light.svg
!/docs/assets/savings-dark.svg
!/docs/assets/savings-light.svg

# ── benchmark: the current battery only ──
# Run RECORDS ship — every number on the published board is recomputed from these 24 files, and a
# board nobody can recompute is a board you have to take on trust. Output TREES do not ship: they
# carry node_modules, and on Strata arms the delivered module source, which lives only on the hub.
/benchmark/*
!/benchmark/quality/
!/benchmark/fixtures/
!/benchmark/harness/
!/benchmark/runs/
!/benchmark/*.js
!/benchmark/*.ts

/benchmark/runs/*
!/benchmark/runs/exp-quality/

# The v1.1 battery. Records only — every number on the published board is recomputed from these, and
# a board nobody can recompute is one you have to take on trust. The output trees stay out: they are
# node_modules plus, on Strata arms, delivered module source that lives only on the hub.
!/benchmark/runs/exp-v12/
!/benchmark/runs/exp-v20/
!/benchmark/runs/exp-v22/
/benchmark/runs/exp-v12/*
/benchmark/runs/exp-v20/*
/benchmark/runs/exp-v22/*
!/benchmark/runs/exp-v12/*.json
!/benchmark/runs/exp-v20/*.json
!/benchmark/runs/exp-v22/*.json

# Module source is delivered from the hub at call time and is never published.
# These are the paths it lands in inside an output tree.
/benchmark/runs/**/strata/lib.js
/benchmark/runs/**/strata/selftest.js
/benchmark/runs/**/strata/tests/
/benchmark/runs/**/strata/composed-pkg/

# Install artifacts of the archived trees — the sessions' code is the artifact, not their lockfiles.
/benchmark/runs/**/package-lock.json

# >>> BEGIN generated recall exclusion — edit scripts/sync-gitignore.js, not this block
# The recall library is served from the hub and is NOT part of this repository. Everything under
# recalls/ stays local: the admitted recalls (their implementations are the project's actual IP)
# and the quarantined npm-scrape junkyard alike. No exceptions, no re-included paths — a single
# `!` line here would put an implementation on GitHub permanently.
/recalls/
# <<< END generated recall exclusion
