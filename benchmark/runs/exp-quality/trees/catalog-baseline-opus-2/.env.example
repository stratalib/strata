DATABASE_URL=file:./dev.db
PORT=3000
SERVICE_NAME=catalog-service

# Per-IP rate limiting (defaults: 100 requests / 60s window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Number of proxy hops to trust for the real client IP (X-Forwarded-For). Leave unset when the service
# is directly exposed; set to the hop count when behind a load balancer / reverse proxy.
# TRUST_PROXY=1
