// Catalog service — data model.
// This is the project's source of truth. Strata re-reads it on every strata_use, so the generated
// field lists can never drift from the schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Category {
  ELECTRONICS
  HOME
  TOYS
  BOOKS
  SPORTS
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  description String?
  price       Float
  quantity    Int
  category    Category
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  country   String
  createdAt DateTime @default(now())
}

model Order {
  id              Int      @id @default(autoincrement())
  customerId      String
  productSku      String
  quantity        Int
  unitPrice       Float
  totalPrice      Float
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())
}
