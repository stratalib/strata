// Catalog service — data model.
// This is the project's source of truth. Strata re-reads it on every strata_use, so the generated
// field lists can never drift from the schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Category {
  ELECTRONICS
  HOME
  TOYS
  BOOKS
  SPORTS
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  description String?
  price       Float
  quantity    Int
  category    Category
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  country   String
  createdAt DateTime @default(now())
}

// Not live — see src/data/orderRepository.js. Documented here as the target shape only, per
// strata.guide.json's note that this schema is aspirational.
model Order {
  id            Int      @id @default(autoincrement())
  customerEmail String
  items         Json
  total         Float
  status        String   @default("CREATED")
  createdAt     DateTime @default(now())
}
