# Copy to .env and fill in. Required in production: STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET.
NODE_ENV=development
PORT=3000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SMTP (Nodemailer)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=receipts@example.com

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Branding on receipts/emails
MERCHANT_NAME=Acme Inc.
MERCHANT_SUPPORT_EMAIL=support@example.com
