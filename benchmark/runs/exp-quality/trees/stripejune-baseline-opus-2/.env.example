NODE_ENV=development
PORT=3000

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SMTP (Nodemailer)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
