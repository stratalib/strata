PORT=3000

# Stripe webhook configuration
STRIPE_WEBHOOK_SECRET=whsec_test...
STRIPE_WEBHOOK_PATH=/webhooks/stripe
STRIPE_WEBHOOK_TOLERANCE_SEC=300

# Email configuration
MAIL_FROM=no-reply@example.com
MAIL_MAX_ATTEMPTS=3
MAIL_BACKOFF_MS=500
# Format: smtp://user:pass@host:port or omit for in-memory recording
MAIL_TRANSPORT=

# Redis configuration
REDIS_URL=redis://localhost:6379

# Proxy configuration (set to number of proxies in front of this app)
TRUST_PROXY_HOPS=
