# Server
PORT=3000
NODE_ENV=development
# Number of trusted reverse proxies in front of this app (nginx/ALB = 1, + Cloudflare = 2).
# Leave unset for local/direct deployments.
TRUST_PROXY_HOPS=

# Stripe
# From the Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_PATH=/webhooks/stripe
STRIPE_WEBHOOK_TOLERANCE_SEC=300

# SMTP (Nodemailer)
# e.g. smtp://user:pass@smtp.mailgun.org:587
# Leave unset to use Nodemailer's jsonTransport (renders emails, sends nothing — safe local default).
SMTP_URL=
MAIL_FROM="Acme Inc. <no-reply@example.com>"
MAIL_MAX_ATTEMPTS=3
MAIL_BACKOFF_MS=500

# Redis / BullMQ
REDIS_URL=redis://127.0.0.1:6379
RECEIPT_WORKER_CONCURRENCY=5

# Branding
COMPANY_NAME=Acme Inc.
SUPPORT_EMAIL=support@example.com
