# --- Server ---
PORT=3000
# Number of reverse proxies in front of this app (nginx/ALB = 1, + Cloudflare = 2). Leave unset
# if there is no proxy (e.g. running directly on the internet or purely local dev).
TRUST_PROXY_HOPS=

# --- Stripe ---
# Secret API key, used only for authenticated calls like fetching Checkout line items — NOT for
# webhook verification, which uses STRIPE_WEBHOOK_SECRET below and needs no SDK.
STRIPE_SECRET_KEY=sk_test_...
# Per-endpoint signing secret from the Stripe Dashboard (or `stripe listen` in local dev).
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_PATH=/webhooks/stripe
STRIPE_WEBHOOK_TOLERANCE_SEC=300

# --- Redis (BullMQ + webhook dedupe) ---
REDIS_URL=redis://127.0.0.1:6379

# --- SMTP / Nodemailer ---
# Leave SMTP_HOST unset to run with nodemailer's jsonTransport (logs mail instead of sending —
# safe default for local dev so a test run cannot email real users).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Only for a self-hosted relay with a private CA / self-signed cert. Leave false (verified TLS)
# for any provider reachable over the public internet.
SMTP_ALLOW_SELF_SIGNED=false
MAIL_FROM="Example Store <no-reply@example.com>"
MAIL_MAX_ATTEMPTS=3
MAIL_BACKOFF_MS=500

# --- Receipt worker ---
RECEIPT_WORKER_CONCURRENCY=5
