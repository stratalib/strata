# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_PATH=/webhooks/stripe
STRIPE_WEBHOOK_TOLERANCE_SEC=300

# Server
PORT=3000
# Number of reverse proxies in front of this app (nginx/ALB = 1, + Cloudflare = 2). Leave unset if none.
TRUST_PROXY_HOPS=

# SMTP — leave unset to use the in-memory test transport (no real email is sent)
SMTP_URL=smtps://user:pass@smtp.example.com
MAIL_FROM=no-reply@example.com
MAIL_MAX_ATTEMPTS=3
MAIL_BACKOFF_MS=500

# Redis (BullMQ)
REDIS_URL=redis://127.0.0.1:6379
RECEIPT_WORKER_CONCURRENCY=5

# Order store (file-backed JSON; point at a persistent volume in production)
ORDER_STORE_DIR=./data
